    <!-- Desktop navigation -->
    <nav aria-label="Primary" class="tablet:hidden">
      <ul class="flex list-none items-center gap-1">
        <li><a href="/" class={navLinkClass}>Home</a></li>
        <li class="group relative">
          <button
            type="button"
            class={`${navLinkClass} inline-flex items-center gap-1`}
            aria-haspopup="true"
            aria-expanded="false"
          >
            Teacher Training
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
              <path
                d="M1 1L5 5L9 1"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
          <div
            class="invisible absolute left-0 top-full min-w-[16rem] rounded-xl bg-white p-2 opacity-0 shadow-lg motion-safe:transition-opacity motion-safe:duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
          >
            <a
              href="https://elearning.creative-hut.com/course/tangiblecodingalgorithms"
              class={dropdownLinkClass}>Coding and Algorithms Online</a
            >
            <a href="/design-thinking" class={dropdownLinkClass}>Design Thinking</a>
          </div>
        </li>
        <li><a href="/news-feed/ teacher-support-chatbot" class={navLinkClass}>Teacher Support</a></li>
        <li><a href="/coding-club" class={navLinkClass}>C# Coding Club</a></li>
        <li><a href="/news-feed" class={navLinkClass}>News Feed</a></li>
        <li><a href="/our-coding" class={navLinkClass}>Our Coding Games</a></li>
        <li aria-hidden="true"><span class="mx-2 inline-block h-[22px] w-px bg-[#E4EBF3]"></span></li>
        <li>
          <a href="/contact" class="border-b-2 border-teal px-2 py-2 text-sm font-medium text-ink"
            >Contact</a
          >
        </li>
        <li>
          <a
            href="/shop"
            class="ml-2 inline-block rounded-full bg-cyan px-6 py-2.5 text-sm font-semibold text-ice motion-safe:transition-transform motion-safe:duration-200 hover:motion-safe:-translate-y-0.5"
            >Shop</a
          >
        </li>
      </ul>
    </nav>

    <!-- Mobile hamburger toggle -->
    <button
      id="nav-toggle"
      type="button"
      class="hidden items-center justify-center rounded-lg p-2 text-ink tablet:flex"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Toggle menu"
    >
      <svg id="icon-menu" width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path
          d="M3 6H21M3 12H21M3 18H21"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
      <svg id="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" class="hidden">
        <path
          d="M6 6L18 18M18 6L6 18"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile navigation panel -->
  <div id="mobile-nav" class="hidden border-t border-mist bg-ice">
    <ul class="flex list-none flex-col items-center gap-1 px-6 py-4">
      <li class="w-full"><a href="/" class={navLinkClass}>Home</a></li>
      <li class="w-full text-center">
        <span class="block px-2 py-2.5 text-sm font-semibold text-ink">Teacher Training</span>
        <a
          href="https://elearning.creative-hut.com/course/tangiblecodingalgorithms"
          class={`${navLinkClass} text-smoke`}>Coding and Algorithms Online</a
        >
        <a href="/design-thinking" class={`${navLinkClass} text-smoke`}>Design Thinking</a>
      </li>
      <li class="w-full"><a href="/news-feed/ teacher-support-chatbot" class={navLinkClass}>Teacher Support</a></li>
      <li class="w-full"><a href="/coding-club" class={navLinkClass}>C# Coding Club</a></li>
      <li class="w-full"><a href="/news-feed" class={navLinkClass}>News Feed</a></li>
      <li class="w-full"><a href="/our-coding" class={navLinkClass}>Our Coding Games</a></li>
      <li class="my-1 h-px w-full bg-mist" aria-hidden="true"></li>
      <li class="w-full"><a href="/contact" class={navLinkClass}>Contact</a></li>
      <li class="w-full pt-1 text-center">
        <a
          href="/shop"
          class="inline-block rounded-full bg-cyan px-8 py-2.5 text-sm font-semibold text-ice"
          >Shop</a
        >
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const panel = document.getElementById("mobile-nav");
  const iconMenu = document.getElementById("icon-menu");
  const iconClose = document.getElementById("icon-close");

  if (toggle && panel && iconMenu && iconClose) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      panel.classList.toggle("hidden", !open);
      iconMenu.classList.toggle("hidden", open);
      iconClose.classList.toggle("hidden", !open);
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    panel.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) {
        setOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setOpen(false);
      }
    });
  }
</script>
