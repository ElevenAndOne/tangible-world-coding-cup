---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import Countdown from "../react/Countdown";
import AmazonLogo from "../brand/AmazonLogo.astro";
import WccLogo from "../brand/WccLogo.astro";
import Button from "../ui/Button.astro";
import heroDeco from "../../assets/images/hero-deco.svg";
import heroPoster from "../../assets/images/hero-teaser-poster.jpg";

// Teaser hosted on R2. The 720p cut backs the autoplaying preview; the
// 1080p cut only loads once the viewer opens the player.
const heroPreview =
  "https://pub-dfe88f38d7c6471bab5ada01af93c688.r2.dev/Tangible_CodingWorldCup2026_Teaser_Small.mp4";
const heroFull =
  "https://pub-dfe88f38d7c6471bab5ada01af93c688.r2.dev/Tangible_CodingWorldCup2026_Teaser.mp4";

---

<Section
  class="overflow-hidden bg-teal px-8 pt-20 pb-16 text-white tablet:px-6 tablet:pt-24 landscape:px-5 landscape:pt-[4.5rem] landscape:pb-12 portrait:px-4 portrait:pt-14"
>
  <img
    slot="background"
    src={heroDeco.src}
    alt=""
    class="pointer-events-none absolute top-[4%] -right-[9%] h-auto w-[46rem] max-w-full opacity-30 mix-blend-lighten tablet:opacity-[0.08]"
  />

  <Container size="full" class="max-w-[90rem]">
    <h1 class="sr-only">Tangible World Coding Cup — 5 November 2026</h1>

    <div class="grid grid-cols-2 items-center gap-16 tablet:grid-cols-1 tablet:gap-12">
      <div class="flex flex-col items-start landscape:items-center landscape:text-center">
        <WccLogo width="clamp(17.5rem, 14.375rem + 10vw, 20rem)" data-reveal style="--reveal-delay: 0ms" />

        <p
          class="mt-5 text-[clamp(1.375rem,1rem+1.1vw,2rem)] leading-[1.2] tracking-[-0.01875rem] text-sky uppercase font-display"
          data-reveal
          style="--reveal-delay: 90ms"
        >
          5 November 2026
        </p>

        <p
          class="mt-7 max-w-[38rem] leading-[1.5] text-white/92 tablet:mt-10 landscape:mt-8"
          data-reveal
          style="--reveal-delay: 180ms"
        >
          On 5 November 2026, learners around the world take on the Speed Stars challenge — building
          code with Tangible pieces, testing it in the Tournament App and racing against teams in
          other countries.
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-7 landscape:gap-4" data-reveal style="--reveal-delay: 270ms">
          <Button href="https://form.jotform.com/262253513708051" class="py-4 pr-4 pl-8 leading-[1.5] landscape:py-2.5 landscape:pr-2.5 landscape:pl-6 landscape:text-base">
            Join the Coding Cup
          </Button>
        </div>

        <div class="mt-7" data-reveal style="--reveal-delay: 315ms">
          <Countdown client:load />
        </div>

        <p class="mt-6 max-w-[38rem] leading-[1.5] text-white/85" data-reveal style="--reveal-delay: 360ms">
          <strong>In South Africa?</strong> Teams qualify through the Tangible National Championships.
          <a href="mailto:info@levafoundation.org" class="font-semibold text-lime underline"
            >Find out more</a
          >
        </p>

        <div class="mt-6 flex items-center gap-2.5 landscape:mt-5" data-reveal style="--reveal-delay: 450ms">
          <p class="text-xs leading-[1.2] font-semibold tracking-[0.0875rem] text-white/75 uppercase">
            Sponsored by
          </p>
          <AmazonLogo class="text-white" />
        </div>
      </div>

      <div class="relative aspect-video overflow-hidden rounded-2xl bg-teal-deep" data-reveal>
        <!-- Low-resolution preview: muted, looping, decorative. Paused under
             reduced-motion, where the poster stands in until play is pressed. -->
        <video
          id="hero-preview"
          class="h-full w-full object-cover"
          src={heroPreview}
          poster={heroPoster.src}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
          tabindex="-1"></video>

        <div
          class="pointer-events-none absolute inset-0 bg-ink/20"
          aria-hidden="true"
        >
        </div>

        <button
          id="hero-play"
          type="button"
          class="group absolute inset-0 flex cursor-pointer items-center justify-center border-0 bg-transparent p-0"
          aria-label="Play the World Coding Cup teaser"
        >
          <span
            class="flex h-20 w-20 items-center justify-center rounded-full bg-lime text-ink shadow-[0_0.5rem_1.5rem_rgba(28,28,28,0.35)] motion-safe:transition-transform motion-safe:duration-200 group-hover:motion-safe:scale-105 landscape:h-16 landscape:w-16"
          >
            <svg width="26" height="30" viewBox="0 0 26 30" fill="none" aria-hidden="true">
              <path d="M25 13.27a2 2 0 0 1 0 3.46L3 29.4A2 2 0 0 1 0 27.67V2.33A2 2 0 0 1 3 .6l22 12.67Z" fill="currentColor"></path>
            </svg>
          </span>
        </button>
      </div>
    </div>
  </Container>
</Section>

<!-- Full-resolution player. Native <dialog> gives Escape-to-close, a focus
     trap and an inert background for free. -->
<dialog
  id="hero-dialog"
  aria-label="World Coding Cup teaser"
  class="m-auto w-[min(92vw,80rem)] max-w-none border-0 bg-transparent p-0 backdrop:bg-ink/90 backdrop:backdrop-blur-sm"
>
  <div class="relative">
    <button
      id="hero-dialog-close"
      type="button"
      class="absolute top-4 right-4 z-10 flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border-0 bg-ice text-ink shadow-[0_0.25rem_1rem_rgba(28,28,28,0.45)] motion-safe:transition-transform motion-safe:duration-200 hover:motion-safe:scale-105 landscape:h-10 landscape:w-10"
      aria-label="Close video"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
      </svg>
    </button>

    <video
      id="hero-dialog-video"
      class="aspect-video w-full rounded-2xl bg-ink"
      src={heroFull}
      poster={heroPoster.src}
      controls
      playsinline
      preload="none"></video>
  </div>
</dialog>

<script>
  const preview = document.getElementById("hero-preview") as HTMLVideoElement | null;
  const playButton = document.getElementById("hero-play");
  const dialog = document.getElementById("hero-dialog") as HTMLDialogElement | null;
  const dialogVideo = document.getElementById("hero-dialog-video") as HTMLVideoElement | null;
  const closeButton = document.getElementById("hero-dialog-close");

  // Autoplay is decorative, so honour a reduced-motion preference by holding
  // the preview on its poster frame instead.
  if (preview && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    preview.autoplay = false;
    preview.pause();
  }

  if (preview && playButton && dialog && dialogVideo && closeButton) {
    const previewShouldPlay = () =>
      !dialog.open && !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Browsers pause autoplaying media while the tab is hidden, so pick the
    // preview back up when the viewer returns to it.
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible" && previewShouldPlay()) {
        void preview.play().catch(() => {});
      }
    });

    const open = () => {
      preview.pause();
      document.documentElement.classList.add("overflow-hidden");
      dialog.showModal();
      // The click counts as a user gesture, so sound is allowed here.
      void dialogVideo.play().catch(() => {
        /* Leave it to the controls if the browser declines. */
      });
    };

    const reset = () => {
      document.documentElement.classList.remove("overflow-hidden");
      dialogVideo.pause();
      dialogVideo.currentTime = 0;
      if (previewShouldPlay()) {
        void preview.play().catch(() => {});
      }
      playButton.focus();
    };

    playButton.addEventListener("click", open);
    closeButton.addEventListener("click", () => dialog.close());

    // Covers the close button, Escape, and a click on the backdrop alike.
    dialog.addEventListener("close", reset);
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) {
        dialog.close();
      }
    });

    // <dialog> normally closes itself on Escape, but the built-in close watcher
    // does not fire in every engine, so drive it explicitly as well.
    dialog.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        event.preventDefault();
        dialog.close();
      }
    });
  }
</script>
