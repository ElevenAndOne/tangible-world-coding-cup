---
import { Image } from "astro:assets";
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import howItWorks from "../../assets/images/how-it-works.avif";

interface Step {
  number: number;
  title: string;
  body: string;
  bg: string;
}

const steps: Step[] = [
  {
    number: 1,
    title: "See the challenge",
    body: "The team opens the challenge in the Tangible Tournament App and works out what it is asking.",
    bg: "bg-sun",
  },
  {
    number: 2,
    title: "Put the device down",
    body: "Learners build their solution together using the physical Tangible puzzle pieces.",
    bg: "bg-lilac",
  },
  {
    number: 3,
    title: "Test the answer",
    body: "Back to the app to run the code and see whether the car makes it round the track.",
    bg: "bg-lime",
  },
  {
    number: 4,
    title: "Change it and race again",
    body: "If it does not work, change something and test again. That is where the learning happens.",
    bg: "bg-ember",
  },
];
---

<Section class="bg-white px-[1.875rem] tablet:px-6 landscape:px-5 portrait:px-4">
  <Container size="full">
  <div
    class="grid grid-cols-[minmax(0,780fr)_minmax(0,1080fr)] items-stretch overflow-hidden rounded-3xl tablet:grid-cols-1 portrait:rounded-2xl"
  >
    <div class="relative min-h-[24rem] tablet:min-h-[18rem] landscape:min-h-[14rem]" data-reveal>
      <Image
        src={howItWorks}
        alt=""
        width={1024}
        height={768}
        sizes="(max-width: 1024px) 100vw, 1024px"
        class="absolute inset-0 h-full w-full object-cover"
      />
    </div>

    <div
      class="flex flex-col items-center justify-center gap-9 bg-teal p-16 tablet:gap-8 tablet:px-8 tablet:py-12 landscape:px-5 landscape:py-10"
    >
      <div class="flex w-full flex-col items-center gap-6" data-reveal>
        <div
          class="inline-flex items-center rounded-full bg-lime px-3.5 py-1.5 text-xs font-semibold uppercase leading-[1.2] tracking-[0.0875rem] text-ink"
        >
          Simple process
        </div>
        <h2
          class="text-center font-display text-[clamp(2rem,1.3rem+2.3vw,3.5rem)] uppercase leading-[1.1] tracking-[-0.05rem] text-white"
        >
          How does it work?
        </h2>
      </div>

      <div class="grid w-full grid-cols-2 items-stretch gap-5 landscape:grid-cols-1 landscape:gap-4">
        {
          steps.map((step, index) => (
            <div
              class={`flex flex-col items-center gap-2 rounded-2xl px-7 pt-6 pb-7 text-center text-ink motion-safe:transition-transform motion-safe:duration-[250ms] hover:motion-safe:-translate-y-[3px] ${step.bg}`}
              data-reveal
              style={`--reveal-delay: ${index * 80}ms`}
            >
              <div class="font-display text-[clamp(1.75rem,1.25rem+1.5vw,2.5rem)] leading-[1.15] tracking-[-0.03125rem]">
                {step.number}
              </div>
              <div class="font-display text-[clamp(1.1875rem,1.125rem+0.208vw,1.3125rem)] leading-[1.3]">
                {step.title}
              </div>
              <p class="m-0 text-[clamp(1.0625rem,0.969rem+0.312vw,1.25rem)] leading-[1.5] opacity-85">
                {step.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
  </Container>
</Section>
