---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";

const qClass =
  "font-display text-[clamp(1.1875rem,1.125rem+0.208vw,1.3125rem)] font-normal leading-[1.3] text-ink";
const aClass = "text-[clamp(1.0625rem,0.969rem+0.312vw,1.25rem)] leading-normal text-smoke";
const rowClass = "flex w-full flex-col items-start gap-2.5 border-t border-mist py-6";
---

<Section class="bg-white px-8 pt-8 pb-0 tablet:px-6 landscape:px-5 portrait:px-4">
  <Container
    size="full"
    class="max-w-[102.5rem] rounded-3xl bg-peach px-24 py-20 tablet:px-10 tablet:py-16 landscape:px-6 landscape:py-12 portrait:rounded-2xl portrait:px-5"
  >
    <h2
      class="mb-10 text-center font-display text-[clamp(1.75rem,1.25rem+1.7vw,2.75rem)] font-normal uppercase leading-[1.15] tracking-[-0.03125rem] text-ink"
      data-reveal
    >
      A few things to know
    </h2>
    <div class="mx-auto grid max-w-[82.5rem] grid-cols-2 gap-16 tablet:grid-cols-1 tablet:gap-0">
      <div class="flex w-full flex-col items-start">
        <div class={rowClass} data-reveal style="--reveal-delay: 0ms">
          <h3 class={qClass}>Who can take part?</h3>
          <p class={aClass}>
            Schools, libraries, coding clubs and learning spaces outside South Africa can join
            directly. South African teams qualify through the Tangible National Championships.
          </p>
        </div>
        <div class={rowClass} data-reveal style="--reveal-delay: 70ms">
          <h3 class={qClass}>Do I need to know how many teams I am bringing?</h3>
          <p class={aClass}>Not yet. Join now and register your final teams closer to the Coding Cup.</p>
        </div>
      </div>
      <div class="flex w-full flex-col items-start">
        <div class={rowClass} data-reveal style="--reveal-delay: 140ms">
          <h3 class={qClass}>Do teachers need to know how to code?</h3>
          <p class={aClass}>
            No. Your role is to bring the learners together and let them work it out. We will help
            you get ready.
          </p>
        </div>
        <div class={rowClass} data-reveal style="--reveal-delay: 210ms">
          <h3 class={qClass}>What if we do not have Tangible game packs?</h3>
          <p class={aClass}>
            Email <a href="mailto:support@levafoundation.org" class="font-semibold text-teal no-underline">support@levafoundation.org</a> to purchase game packs before the tournament.
          </p>
        </div>
      </div>
    </div>
  </Container>
</Section>
