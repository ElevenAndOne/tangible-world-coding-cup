---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import iconGamepacks from "../../assets/images/icon-gamepacks.svg";
import iconDevice from "../../assets/images/icon-device.svg";
import iconTeam from "../../assets/images/icon-team.svg";
import iconCoordinator from "../../assets/images/icon-coordinator.svg";

interface InfoLink {
  href: string;
  label: string;
  external?: boolean;
}

interface InfoCategory {
  label: string;
  detail: string;
}

interface InfoCard {
  icon: { src: string };
  bar: string;
  title: string;
  text: string;
  categories?: InfoCategory[];
  note?: string;
  links: InfoLink[];
}

const cards: InfoCard[] = [
  {
    icon: iconGamepacks,
    bar: "bg-lime",
    title: "Tangible game packs",
    text: "A Tangible game pack for every team taking part.",
    links: [{ href: "mailto:support@levafoundation.org", label: "Buy game packs →" }],
  },
  {
    icon: iconDevice,
    bar: "bg-sky",
    title: "A device and the app",
    text: "One phone or tablet per team, running the Tangible Tournament App.",
    links: [
      {
        href: "https://play.google.com/store/apps/details?id=com.leva.tournament",
        label: "Google Play →",
        external: true,
      },
      {
        href: "https://apps.apple.com/az/app/tournament-powered-by-tangible/id6747891095",
        label: "App Store →",
        external: true,
      },
    ],
  },
  {
    icon: iconTeam,
    bar: "bg-sun",
    title: "A team of learners",
    text: "3 to 5 per team, with three competition categories:",
    categories: [
      { label: "Junior", detail: "schools, libraries and learning spaces (~7–13 years)" },
      { label: "Senior", detail: "schools, libraries and learning spaces (~13–18 years)" },
      { label: "Open", detail: "university / tertiary students (~18+ years)" },
    ],
    note: "Learners enter according to their current education level, not strictly their age.",
    links: [],
  },
  {
    icon: iconCoordinator,
    bar: "bg-ember",
    title: "One coordinator",
    text: "A teacher, librarian or volunteer. No coding knowledge needed.",
    links: [
      {
        href: "https://drive.google.com/open?id=1N7Isr9YiHb0lHEsjTwaxM-ZnWcSkTvgu&usp=drive_fs",
        label: "How to prepare →",
        external: true,
      },
    ],
  },
];
---

<Section id="what-you-need" class="bg-white py-20 px-8 tablet:py-18 tablet:px-6 landscape:py-14 landscape:px-5 portrait:px-4">
  <Container size="lg">
    <h2
      class="mb-12 text-center font-display text-[clamp(2rem,1.3rem+2.3vw,3.5rem)] font-normal uppercase leading-[1.1] tracking-[-0.05rem] text-ink tablet:mb-10"
      data-reveal
    >
      What do we need?
    </h2>
    <div class="grid grid-cols-4 gap-6 tablet:grid-cols-2 landscape:grid-cols-1 landscape:gap-4">
      {
        cards.map((card, index) => (
          <div
            class="flex h-full flex-col overflow-hidden rounded-lg bg-peach transition-transform duration-[250ms] ease-in-out motion-safe:hover:-translate-y-[3px]"
            data-reveal
            style={`--reveal-delay: ${index * 80}ms`}
          >
            <div class="flex flex-grow flex-col items-start gap-3.5 p-8 landscape:p-6">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg border-[1.5px] border-teal">
                <img src={card.icon.src} alt="" class="h-6 w-6" />
              </div>
              <h3 class="font-display text-[clamp(1.1875rem,1.125rem+0.208vw,1.3125rem)] font-normal leading-[1.3] text-ink">
                {card.title}
              </h3>
              <div class="flex flex-col gap-2">
                <p class="text-base leading-normal text-smoke">{card.text}</p>
                {card.categories && (
                  <ul class="flex flex-col gap-0.5 text-base leading-normal text-smoke">
                    {card.categories.map((category) => (
                      <li>
                        <strong>{category.label}:</strong> {category.detail}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
              {card.note && (
                <p class="text-sm italic leading-normal text-smoke">{card.note}</p>
              )}
              {card.links.length === 1 && (
                <a
                  href={card.links[0].href}
                  target={card.links[0].external ? "_blank" : undefined}
                  rel={card.links[0].external ? "noopener" : undefined}
                  class="mt-auto text-lg font-semibold leading-normal tracking-[0.0125rem] text-teal no-underline"
                >
                  {card.links[0].label}
                </a>
              )}
              {card.links.length > 1 && (
                <div class="mt-auto flex flex-col items-start gap-1">
                  {card.links.map((link) => (
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener"
                      class="text-lg font-semibold leading-normal tracking-[0.0125rem] text-teal no-underline"
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
            <div class={`h-1 w-full shrink-0 ${card.bar}`} />
          </div>
        ))
      }
    </div>
  </Container>
</Section>
