---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/layout/Container.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Button from "../components/ui/Button.astro";
import TemplateDialog from "../components/ui/TemplateDialog.astro";
import { storySubmissionFormUrl, storySubmissionUrl } from "../data/communications";
import Icon from "../components/ui/Icon.astro";
import { Image } from "astro:assets";
import { statSync } from "node:fs";
import AmazonLogo from "../components/brand/AmazonLogo.astro";
import WccLogo from "../components/brand/WccLogo.astro";
import learnersImage from "../assets/images/toolkit-learners.avif";
import codingImage from "../assets/images/toolkit-coding.avif";
import teamImage from "../assets/images/toolkit-team.avif";
import heroDeco from "../assets/images/hero-deco.svg";

// Files are served from public/downloads/. Sizes are read at build time, so a missing file fails the build.
const fileSize = (file: string) => {
  const bytes = statSync(`public/downloads/${file}`).size;
  return bytes < 1_000_000 ? `${Math.round(bytes / 1000)} KB` : `${(bytes / 1_000_000).toFixed(1)} MB`;
};

const resources = [
  { icon: "trophy", title: "World Coding Cup logos", detail: "Colour and white versions", format: "ZIP · PNG + SVG", file: "world-coding-cup-logos.zip" },
  { icon: "smartphone", title: "Social media graphics", detail: "Landscape, portrait and story formats", format: "ZIP · JPG + PNG", file: "world-coding-cup-social-graphics.zip" },
  { icon: "newspaper", title: "Newsletter graphic", detail: "Ready-to-use header image", format: "JPG", file: "world-coding-cup-newsletter-header.jpg" },
  { icon: "monitor", title: "Website graphics", detail: "Banner and inline versions", format: "ZIP · PNG", file: "world-coding-cup-website-graphics.zip" },
] as const;

// Editable Canva template shared by Wendy on 21 October 2026. Canva opens a copy, so the original stays unchanged.
const canvaTemplateUrl = "https://canva.link/e0ils4wreth5tmo";

const mediaReasons = [
  "Your learners are representing their town, region or country",
  "This is the first time your school has done something like this",
  "A large number of learners are involved",
  "Girls are leading the way",
  "There is a strong learner or teacher story",
  "Your learners overcame an interesting challenge",
  "Your community came together to make participation possible",
];

// From the client's "Sponsored by Amazon guidelines" Google Doc (modified 15 October 2026),
// condensed to Wendy's replacement wording in her annotated PDF of 29 October 2026.
const photographyBrief = [
  {
    title: "The look and feel",
    points: [
      ["Natural, bright and real.", "Photograph learners at work, with teachers supporting them. Show Tangible pieces in use, not just screens. Avoid staged reactions and posed photographs."],
    ],
  },
  {
    title: "The shots we need",
    points: [
      ["Prioritise photographs we can use again.", "Capture hands arranging pieces, over-the-shoulder views, teamwork and wide shots of the event. Include recognisable faces where permission allows, plus Tangible and Amazon branding where present."],
    ],
  },
  {
    title: "Protecting children",
    points: [
      ["Check permissions before taking or sharing photographs.", "Respect children’s privacy and their right not to be photographed. Watch for names, badges and personal information in the background. If permission is unclear, don’t publish the image."],
    ],
  },
] as const;

const logoRules = [
  "Use only the supplied Sponsored by Amazon artwork.",
  "Always display it alongside the Tangible World Coding Cup logo.",
  "Keep both logos intact, clear and readable.",
  "Only use the sponsorship artwork for World Coding Cup communications, not general school activities.",
];

const sponsorshipDonts = [
  "Don’t suggest Amazon sponsors your school or other activities.",
  "Don’t use the artwork on merchandise without approval.",
  "Refer requests for Amazon quotes or statements to the Tangible team.",
];

---

<BaseLayout
  title="School Communications Toolkit | World Coding Cup"
  description="Ready-to-use messages, media guidance and resources for schools taking part in the Tangible World Coding Cup."
>
  <Header slot="header" />

    <section class="hero">
      <img src={heroDeco.src} alt="" aria-hidden="true" class="hero-pattern" />
      <Container size="xl" class="px-6 portrait:px-4">
        <div class="hero-grid">
        <div class="hero-copy">
          <WccLogo title="Tangible World Coding Cup" class="hero-logo" />
          <h1>Taking part<br />is worth sharing.</h1>
          <p class="hero-intro">Bring your school and community into your Tangible World Coding Cup journey. Use these ready-made resources to let people know you’re taking part and celebrate what your learners achieve.</p>
          <div class="hero-actions">
            <Button href="#start-here" arrow="down">Start with the quick guide</Button>
            <span class="sponsor"><span>Sponsored by</span><AmazonLogo class="text-white" /></span>
          </div>
        </div>
        <figure class="hero-photo">
          <Image src={learnersImage} alt="Learners working together with Tangible coding pieces" width={1600} widths={[480, 768, 1024, 1280, 1600]} sizes="(max-width: 850px) calc(100vw - 48px), (max-width: 1472px) 44vw, 650px" format="webp" quality={85} loading="eager" fetchpriority="high" class="toolkit-photo" />
          <figcaption>One team. One big story.</figcaption>
        </figure>
        </div>
      </Container>
    </section>

    <section id="start-here" class="section-pad bg-white">
      <Container size="xl" class="px-6 portrait:px-4">
        <div class="section-heading">
          <p class="eyebrow">START HERE</p>
          <h2>Five things we’d love every school to do</h2>
          <p>You don’t need to be a communications expert. Start with the channels your school already uses.</p>
        </div>
        <div class="steps-grid">
          <article class="step-card"><span class="step-number">01</span><h3>Tell your parents</h3><p>Use our ready-to-share WhatsApp or email message.</p><Button data-template="parents" size="sm">Open parent message</Button></article>
          <article class="step-card"><span class="step-number">02</span><h3>Put it in your newsletter</h3><p>Adapt a short article with your school’s details.</p><Button data-template="newsletter" size="sm">Open newsletter story</Button></article>
          <article class="step-card"><span class="step-number">03</span><h3>Share on social media</h3><p>Choose a caption, add approved photographs and celebrate your learners.</p><Button data-template="social" size="sm">Open social captions</Button></article>
          <article class="step-card"><span class="step-number">04</span><h3>Add it to your website</h3><p>Use a ready-to-edit school news story.</p><Button data-template="website" size="sm">Open website story</Button></article>
          <article class="step-card step-card-featured"><span class="step-number">05</span><h3>Share your story with Tangible</h3><p>Send us your highlights and help learners become part of the global World Coding Cup story.</p><div class="step-actions">{storySubmissionUrl && <Button href={storySubmissionUrl} target={storySubmissionFormUrl ? "_blank" : undefined} rel={storySubmissionFormUrl ? "noopener" : undefined} size="sm">Share your story{storySubmissionFormUrl && <span class="sr-only"> (opens in a new tab)</span>}</Button>}<Button href="#submit" variant="secondary" size="sm" arrow="down">See what to send</Button></div></article>
        </div>
      </Container>
    </section>

    <section class="section-pad bg-white">
      <Container size="xl" class="px-6 portrait:px-4">
        <div class="media-layout">
        <figure class="media-image"><Image src={codingImage} alt="Learners arranging Tangible coding pieces around a phone" width={1600} widths={[480, 768, 1024, 1280, 1600]} sizes="(max-width: 850px) calc(100vw - 48px), (max-width: 1472px) 42vw, 600px" format="webp" quality={85} class="toolkit-photo" /><figcaption>Small pieces. Big ideas.</figcaption></figure>
        <div class="media-copy"><p class="eyebrow">WANT TO GO FURTHER?</p><h2>Could this be a local news story?</h2>
          <h3 class="small-label">Your story may be especially interesting if:</h3>
          <ul class="check-list">{mediaReasons.map((reason) => <li>{reason}</li>)}</ul>
          <div class="media-actions"><div><strong>Press release</strong><span>Personalise a local announcement</span></div><Button data-template="pressRelease" variant="soft" size="sm">Open release copy</Button><div><strong>Media email</strong><span>A short note to send with photos</span></div><Button data-template="mediaEmail" variant="soft" size="sm">Open email copy</Button><div><strong>Who should I send it to?</strong><span>Find the right journalist or publication</span></div><Button data-template="mediaTips" variant="soft" size="sm">See media tips</Button></div>
        </div>
        </div>
      </Container>
    </section>

    <section id="photography" class="section-pad bg-ice">
      <Container size="xl" class="px-6 portrait:px-4">
        <div class="photo-safety">
          <div class="photo-intro"><div><p class="eyebrow">PHOTOGRAPHY BRIEF · 5 NOVEMBER 2026</p><h2>Take photographs that tell the story</h2></div><p>Capture learners coding, solving problems and working together. Share these tips with whoever is taking photographs on the day.</p></div>
          <div class="brief-grid">{photographyBrief.map((group) => (
            <article class="brief-card"><h3>{group.title}</h3><ul>{group.points.map(([lead, text]) => <li><strong>{lead}</strong> {text}</li>)}</ul></article>
          ))}</div>
          <div class="safety-callout"><span><Icon name="shield-check" /></span><p><strong>Children’s safety comes first.</strong> If you’re unsure whether you have permission to share an image, don’t publish it.</p></div>
        </div>
      </Container>
    </section>

    <section id="resources" class="section-pad bg-white">
      <Container size="xl" class="px-6 portrait:px-4">
        <div id="downloads" class="section-heading"><p class="eyebrow">RESOURCE LIBRARY</p><h2>World Coding Cup resources</h2><p>Approved World Coding Cup graphics, ready to download and use. Follow the <a href="#sponsor-guidelines">Amazon sponsorship guidelines</a> whenever you share them.</p></div>
        <div class="resource-grid">{resources.map((resource) => {
          const size = fileSize(resource.file);
          return <article class="resource-card"><span class="card-icon"><Icon name={resource.icon} /></span><h3>{resource.title}</h3><p>{resource.detail}</p><div class="resource-bottom"><span>{resource.format} · {size}</span><Button href={`/downloads/${resource.file}`} download={resource.file} icon="download" variant="soft" size="sm" aria-label={`Download ${resource.title} (${resource.format.split(" · ")[0]}, ${size})`}>Download</Button></div></article>;
        })}</div>
        <div class="customise">
          <div class="customise-copy"><p class="eyebrow">PERSONALISE YOUR OWN</p><h3>Social media templates</h3><p>Add your school’s name, photographs and details to an editable Canva template, then download it for your own posts. Canva opens your own copy, so the original stays unchanged.</p></div>
          <Button href={canvaTemplateUrl} target="_blank" rel="noopener" variant="soft" size="sm">Customise in Canva<span class="sr-only"> (opens in a new tab)</span></Button>
        </div>
      </Container>
    </section>

    <section id="sponsor-guidelines" class="section-pad bg-ice">
      <Container size="xl" class="px-6 portrait:px-4">
        <div class="section-heading"><p class="eyebrow">SPONSORED BY AMAZON</p><h2>Amazon sponsorship guidelines</h2><p>Amazon sponsors the Tangible World Coding Cup 2026. Please use these guidelines when promoting your participation or sharing stories and results from the tournament.</p></div>
        <div class="guideline-grid">
          <article class="guideline-card"><span class="card-icon"><Icon name="image" /></span><h3>Using the logo</h3><ul class="check-list">{logoRules.map((rule) => <li>{rule}</li>)}</ul></article>
          <article class="guideline-card"><span class="card-icon"><Icon name="pen-line" /></span><h3>Acknowledging Amazon in writing</h3><p>Include <strong>“sponsored by Amazon”</strong> in press releases, newsletters, website articles and original social posts, even when the logo appears in the image.</p><p class="example-label">For example</p><p class="example">“Our learners are taking part in the Tangible World Coding Cup 2026, sponsored by Amazon.”</p></article>
          <article class="guideline-card"><span class="card-icon"><Icon name="link" /></span><h3>Keep the sponsorship connected to the tournament</h3><ul class="dot-list">{sponsorshipDonts.map((rule) => <li>{rule}</li>)}</ul></article>
        </div>
        <aside class="guideline-contact" aria-label="Sponsorship and branding support"><p><strong>Have a question or need support?</strong> If you’re planning a joint announcement or need help with branding, contact the Tangible team at <a href="mailto:support@levafoundation.org">support@levafoundation.org</a>.</p></aside>
      </Container>
    </section>

    <section id="submit" class="submit-section">
      <Container size="xl" class="px-6 portrait:px-4">
        <div class="submit-grid">
        <div><p class="eyebrow">AFTER THE EVENT</p><h2>Now tell us what happened.</h2><p>Every local story helps us build the global World Coding Cup story. Gather these details before you send your highlights.</p><ul class="submit-list"><li>Your school or organisation</li><li>Your city and country</li><li>Number of learners and teams</li><li>One memorable moment</li><li>Your best 3–5 photographs</li><li>A short video if you have one</li><li>Links to anything you’ve shared</li><li>Links to any media coverage</li><li>Confirmation that permissions are in place</li></ul>
          {storySubmissionUrl ? (
            <Button href={storySubmissionUrl} class="submit-cta" target={storySubmissionFormUrl ? "_blank" : undefined} rel={storySubmissionFormUrl ? "noopener" : undefined}>Share your World Coding Cup story{storySubmissionFormUrl && <span class="sr-only"> (opens in a new tab)</span>}</Button>
          ) : (
            <><Button disabled aria-describedby="submission-status">Story submissions opening soon</Button><p id="submission-status" class="submit-hint">We’ll add the story submission link here as soon as it is confirmed. Keep your highlights and approved photographs ready.</p></>
          )}</div>
        <figure class="submit-art"><Image src={teamImage} alt="A team of learners testing their code together on a tablet" width={1170} widths={[480, 768, 1024, 1170]} sizes="(max-width: 850px) calc(100vw - 48px), (max-width: 1472px) 42vw, 600px" format="webp" quality={90} class="toolkit-photo" /><figcaption class="submit-quote">Thousands of learners.<br />Hundreds of schools.<br /><strong>One global story.</strong></figcaption></figure>
        </div>
      </Container>
    </section>
  <TemplateDialog />
  <Footer slot="footer" whatsappCta={false} />
</BaseLayout>

<style>
  :global(html) { scroll-padding-top: 5rem; }
  :global(body) { background:#fff; }
  .hero { position:relative; overflow:hidden; background:var(--color-teal); color:white; padding:5rem 0; }
  .hero-pattern { position:absolute; top:4%; right:-9%; width:56rem; max-width:75%; height:auto; opacity:.25; mix-blend-mode:lighten; pointer-events:none; }
  .hero-grid { position:relative; display:grid; grid-template-columns:1.05fr .95fr; align-items:center; gap:4.5rem; }
  .hero-copy { max-width:43rem; } .hero-copy :global(.hero-logo) { display:block; width:10rem; height:auto; margin-bottom:2rem; } .eyebrow { margin:0 0 1rem; color:var(--color-teal); font-size:.75rem; font-weight:800; letter-spacing:.14em; text-transform:uppercase; }
  h1,h2,h3,p { margin-top:0; }
  h1,h2 { font-family:var(--font-display); font-weight:400; letter-spacing:-.035em; }
  h1 { margin-bottom:1.25rem; font-size:clamp(3.25rem,5.2vw,5.25rem); line-height:1.02; }
  .hero-intro { max-width:38rem; color:#effbfc; font-size:1.2rem; line-height:1.6; }
  .hero-actions { display:flex; align-items:center; flex-wrap:wrap; gap:2rem; margin-top:2rem; }
  .sponsor { display:flex; align-items:center; gap:.55rem; color:white; font-size:.75rem; } .sponsor :global(svg) { width:3.5rem; }
  figure { margin:0; min-width:0; }
  .hero-photo { overflow:hidden; border-radius:1.25rem; background:var(--color-teal-deep); }
  :global(.toolkit-photo) { display:block; width:100%; height:auto; }
  .hero-photo figcaption,.media-image figcaption { padding:1rem 1.25rem; font-size:.9rem; font-weight:700; }
  .hero-photo figcaption { color:white; }
  .section-pad { padding:6rem 0; } .bg-white { background:#fff; } .bg-ice { background:#f0f8fb; }
  .section-heading { max-width:49rem; margin:0 auto 2.7rem; text-align:center; } .section-heading h2,.media-copy h2,.photo-safety h2,.submit-grid h2 { margin-bottom:.9rem; font-size:clamp(2.3rem,4vw,3.7rem); line-height:1.08; }
  .section-heading>p:last-child,.media-copy>p:not(.eyebrow),.photo-intro>p,.submit-grid>div:first-child>p:not(.eyebrow) { color:var(--color-smoke); font-size:1.05rem; line-height:1.6; }
  .steps-grid { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); gap:1rem; }
  .step-card { display:flex; flex-direction:column; align-items:flex-start; grid-column:span 2; min-height:15rem; padding:1.5rem; border:1px solid #dce8eb; border-radius:1rem; background:white; }
  .step-card > :global(.group),.step-actions { margin-top:auto; } .step-actions { display:flex; flex-wrap:wrap; gap:.75rem; }
  .step-card:nth-child(4),.step-card:nth-child(5) { grid-column:span 3; } .step-card-featured { background:var(--color-ice); }
  .step-number { display:inline-block; margin-bottom:1.25rem; color:var(--color-teal); font-size:.82rem; font-weight:800; letter-spacing:.1em; }
  .step-card h3,.resource-card h3,.guideline-card h3 { margin-bottom:.45rem; font-size:1.2rem; font-weight:800; } .step-card p,.resource-card p,.guideline-card p { color:var(--color-smoke); line-height:1.5; }
  .section-heading a,.guideline-contact a { color:var(--color-teal-deep); font-weight:700; text-decoration:underline; text-underline-offset:.15em; } .section-heading a:hover,.guideline-contact a:hover { color:var(--color-ink); }
  .card-icon { display:inline-flex; align-items:center; justify-content:center; width:2.75rem; height:2.75rem; margin-bottom:1rem; border-radius:.75rem; background:var(--color-ice); color:var(--color-teal-deep); }
  .media-layout { display:grid; grid-template-columns:.9fr 1.1fr; align-items:center; gap:4rem; } .media-image { overflow:hidden; border-radius:1.25rem; background:var(--color-ice); }
  .media-copy h2 { max-width:38rem; } .small-label { margin:1.5rem 0 .7rem; font-size:.78rem; letter-spacing:.08em; text-transform:uppercase; }
  .check-list,.submit-list { display:grid; gap:.6rem; margin:0; padding:0; list-style:none; }
  .check-list li,.submit-list li { position:relative; padding-left:1.5rem; line-height:1.45; } .check-list li:before,.submit-list li:before { position:absolute; left:0; color:var(--color-teal); content:"✓"; font-weight:900; }
  .media-actions { display:grid; grid-template-columns:1fr auto; align-items:center; gap:1rem; margin-top:1.6rem; padding-top:1.2rem; border-top:1px solid #dfe9ec; } .media-actions div { display:grid; } .media-actions div span { color:var(--color-smoke); font-size:.85rem; }
  .photo-safety { display:grid; gap:2.5rem; } .photo-intro { display:grid; grid-template-columns:1.15fr .85fr; align-items:end; gap:1rem 4rem; } .photo-intro h2 { margin-bottom:0; } .photo-intro>p { margin:0; }
  .brief-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; } .brief-card { padding:1.5rem; border-radius:1rem; background:white; } .brief-card h3 { margin-bottom:1rem; font-size:1.2rem; font-weight:800; }
  .brief-card ul { display:grid; gap:1rem; margin:0; padding:0; list-style:none; } .brief-card li { color:var(--color-smoke); font-size:.95rem; line-height:1.55; } .brief-card strong { display:block; margin-bottom:.15rem; color:var(--color-ink); }
  .safety-callout { grid-column:1/-1; display:flex; align-items:center; gap:1rem; max-width:56rem; margin:0 auto; padding:1.1rem 1.5rem; border-radius:1rem; background:#1c292d; color:white; } .safety-callout>span { display:flex; flex-shrink:0; color:var(--color-lime); } .safety-callout p { margin:0; line-height:1.55; } .safety-callout strong { color:var(--color-lime); }
  .resource-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:1rem; margin-bottom:2.5rem; } .resource-card { display:flex; min-height:14.5rem; flex-direction:column; padding:1.4rem; border:1px solid #e1eaed; border-radius:1rem; }
  .resource-card h3 { font-size:1.05rem; } .resource-card p { margin-bottom:1rem; font-size:.92rem; } .resource-bottom { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:.5rem; margin-top:auto; color:#68777c; font-size:.78rem; font-weight:700; }
  .customise { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:1.25rem 2rem; padding:1.5rem; border-radius:1rem; background:var(--color-ice); } .customise-copy { flex:1 1 28rem; min-width:0; } .customise .eyebrow { margin-bottom:.5rem; } .customise h3 { margin-bottom:.45rem; font-size:1.2rem; font-weight:800; } .customise p:last-child { margin:0; color:var(--color-smoke); line-height:1.5; }
  .dot-list { display:grid; gap:.6rem; margin:0; padding-left:1.1rem; list-style:disc; color:var(--color-smoke); font-size:.95rem; line-height:1.5; } .dot-list li::marker { color:var(--color-teal); }
  .guideline-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; } .guideline-card { display:flex; flex-direction:column; align-items:flex-start; padding:1.5rem; border-radius:1.1rem; background:white; box-shadow:0 .4rem 1.5rem #173b4b0a; }
  .guideline-card h3 { margin-bottom:1rem; } .guideline-card p { margin-bottom:.9rem; font-size:.95rem; } .guideline-card p:last-child { margin-bottom:0; } .guideline-card p strong { color:var(--color-ink); } .guideline-card .check-list { font-size:.95rem; }
  .guideline-card .example-label { margin:.3rem 0 .4rem; color:var(--color-ink); font-size:.75rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; } .guideline-card .example { width:100%; padding:.75rem 1rem; border-radius:.5rem; background:var(--color-ice); color:var(--color-ink); font-weight:600; }
  .guideline-contact { max-width:56rem; margin:1.5rem auto 0; padding:1.1rem 1.5rem; border-radius:1rem; background:white; } .guideline-contact p { margin:0; color:var(--color-smoke); line-height:1.55; } .guideline-contact strong { color:var(--color-ink); } .guideline-contact a { overflow-wrap:anywhere; }
  .submit-section { overflow:hidden; background:var(--color-teal); color:white; padding:6rem 0; } .submit-grid { display:grid; grid-template-columns:1fr .9fr; align-items:center; gap:4rem; } .submit-grid .eyebrow { color:var(--color-lime); } .submit-grid h2 { max-width:38rem; } .submit-grid>div:first-child>p:not(.eyebrow) { max-width:40rem; color:#ebf6f7; }
  .submit-list { margin:1.5rem 0 2rem; } .submit-grid :global(.submit-cta) { padding:.75rem .75rem .75rem 2rem; font-size:1.3rem; box-shadow:0 .75rem 2rem #0422294d; } .submit-list li:before { color:var(--color-lime); } .submit-hint { margin:.8rem 0 0; font-size:.82rem!important; }
